# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# MongoDB — Activity Log (separate database, can point at same host as auth)
MONGODB_ACTIVITY_URI=mongodb://localhost:27017
MONGODB_ACTIVITY_DB=learner_activity
MONGODB_ACTIVITY_COL=activity_logs

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
